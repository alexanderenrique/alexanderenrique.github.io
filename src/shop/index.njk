<h2>PCBs</h2>

<div class="product-list" role="list">
{% for product in pcbs %}
  <article class="product-row" role="listitem">
    <div class="product-row__media" aria-hidden="true">
      <div class="product-row__placeholder">{{ product.emoji }}</div>
    </div>
    <div class="product-row__body">
      <h3 class="product-row__title">{{ product.title }}</h3>
      <p class="product-row__description">{{ product.description | safe }}</p>
      <div class="product-row__links">
        <a href="{{ shopify.products[product.shopifyKey] }}" class="product-row__link">Buy →</a>
        <a href="{{ product.projectUrl | url }}" class="product-row__link">Project →</a>
      </div>
    </div>
  </article>
{% endfor %}
</div>

<h2>For the Ambitious Types</h2>

<p class="shop-github-intro">Prefer GitHub to Shopify? Everything on this page is open source. Always has been, always will be.</p>

<div class="product-list" role="list">
{% for block in githubGoGetters %}
  <article class="product-row" role="listitem">
    <div class="product-row__media" aria-hidden="true">
      <div class="product-row__placeholder">{{ block.emoji }}</div>
    </div>
    <div class="product-row__body">
      <h3 class="product-row__title">{{ block.title }}</h3>
      <p class="product-row__description">{{ block.description }}</p>
      <div class="product-row__links">
        {% for link in block.links %}
          <a href="{{ link.url }}" class="product-row__link" target="_blank" rel="noopener noreferrer">{{ link.label }} →</a>
        {% endfor %}
      </div>
    </div>
  </article>
{% endfor %}
</div>

<p class="shop-footnote"><strong>Why don't I sell already assembled boards?</strong> Because assembling boards turns them into "intentional radiators", which would require FCC emissions compliance for an emitting device. Maybe someday though...</p>

