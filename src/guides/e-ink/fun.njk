---
layout: base.njk
title: "E-Ink Display Setup - Fun Mode"
permalink: /e-ink/config-fun/
---

<link rel="stylesheet" href="{{ '/assets/css/setup.css' | url }}">

<article class="container">
    <header class="page-header">
        <h1>E-Ink Display Setup - Fun Mode</h1>
        <p class="page-description">Connect and configure your e-ink display for fun mode</p>
    </header>
    
    <div class="page-content">
        <div class="setup-container">
            <!-- Status Display -->
            <div id="status-container" class="status-container">
                <div id="status-message" class="status-message">Ready to connect</div>
                <div id="status-indicator" class="status-indicator status-ready"></div>
            </div>

            <!-- Connection Section -->
            <section class="setup-section">
                <h2>Connection</h2>
                <div class="form-group">
                    <button id="scan-connect-btn" class="btn btn-primary">Scan and Connect</button>
                </div>
            </section>

            <!-- Configuration Form -->
            <section class="setup-section">
                <h2>Fun Mode Configuration</h2>
                <form id="config-form" class="config-form">
                    <div class="form-group">
                        <label for="display-name">Display Name</label>
                        <input type="text" id="display-name" name="displayName" placeholder='e.g. Living room e-ink' autocomplete="off">
                    </div>

                    <div class="form-group">
                        <label for="wifi-ssid">WiFi SSID</label>
                        <input type="text" id="wifi-ssid" name="wifiSSID" placeholder="Enter WiFi network name" required>
                    </div>

                    <div class="form-group">
                        <label for="wifi-password">WiFi Password</label>
                        <input type="password" id="wifi-password" name="wifiPassword" placeholder="Enter WiFi password" required>
                    </div>

                    <div class="form-group">
                        <label for="refresh-interval">Refresh Interval (minutes)</label>
                        <input type="number" id="refresh-interval" name="refreshInterval" min="1" value="60" required>
                    </div>

                    <div class="form-group">
                        <label>Facts</label>
                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.room_data" value="true" checked>
                                <span>Room Data</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.earthquake" value="true" checked>
                                <span>Earthquake</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.cat_facts" value="true" checked>
                                <span>Cat Facts</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.all_new_facts" value="true" checked>
                                <span>All New Facts</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.iss" value="true" checked>
                                <span>ISS location</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.useless_facts" value="true" checked>
                                <span>Useless Facts</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="apis.special_messages" value="true" checked>
                                <span>Special Messages</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" id="send-config-btn" class="btn btn-primary" disabled>Send Configuration</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</article>

<script type="module" src="{{ '/assets/js/setup.js' | url }}"></script>

