---
layout: base.njk
title: "E-Ink Display Setup - Sensor Mode"
permalink: /e-ink/sensor/
---

<link rel="stylesheet" href="{{ '/assets/css/setup.css' | url }}">

<article class="container">
    <header class="page-header">
        <h1>E-Ink Display Setup - Sensor Mode</h1>
        <p class="page-description">Connect and configure your e-ink display for sensor monitoring</p>
    </header>
    
    <div class="page-content">
        <div class="setup-container">
            <!-- Status Display -->
            <div id="status-container" class="status-container">
                <div id="status-message" class="status-message">Ready to connect</div>
                <div id="status-indicator" class="status-indicator status-ready"></div>
            </div>

            <!-- Connection Section -->
            <section class="setup-section">
                <h2>Connection</h2>
                <div class="form-group">
                    <button id="scan-connect-btn" class="btn btn-primary">Scan and Connect</button>
                </div>
            </section>

            <!-- Configuration Form -->
            <section class="setup-section">
                <h2>Sensor Mode Configuration</h2>
                <form id="config-form" class="config-form">
                    <div class="form-group">
                        <label for="nemo-api-endpoint">NEMO API Endpoint</label>
                        <input type="url" id="nemo-api-endpoint" name="nemoApiEndpoint" placeholder="https://nemo.stanford.edu/api/sensors/sensor_data/" required>
                    </div>

                    <div class="form-group">
                        <label for="nemo-token">NEMO Token</label>
                        <input type="password" id="nemo-token" name="nemoToken" placeholder="40 digit numbers and letters" required>
                    </div>

                    <div class="form-group">
                        <label for="nemo-sensor-id">NEMO Sensor ID</label>
                        <input type="text" id="nemo-sensor-id" name="nemoSensorId" placeholder="Enter NEMO sensor ID" required>
                    </div>

                    <div class="form-group">
                        <label for="sensor-location">Sensor Location</label>
                        <input type="text" id="sensor-location" name="sensorLocation" placeholder="Displayed at the top of the screen" required>
                    </div>

                    <div class="form-group">
                        <label for="refresh-interval">Refresh Interval (minutes)</label>
                        <input type="number" id="refresh-interval" name="refreshInterval" min="1" value="60" required>
                    </div>

                    <div class="form-group">
                        <label for="wifi-ssid">WiFi SSID</label>
                        <input type="text" id="wifi-ssid" name="wifiSsid" placeholder="Enter WiFi network name" required>
                    </div>

                    <div class="form-group">
                        <label for="wifi-password">WiFi Password</label>
                        <input type="password" id="wifi-password" name="wifiPassword" placeholder="Enter WiFi password" required>
                    </div>

                    <div class="form-group">
                        <button type="submit" id="send-config-btn" class="btn btn-primary" disabled>Send Configuration</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</article>

<script type="module" src="{{ '/assets/js/setup.js' | url }}"></script>
